# PostgreSQL Database Connection URL Example
# Replace with your local PostgreSQL user credentials
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/financial_intelligence

# RAG Embedding Provider Configuration: 'local' (sentence-transformers/all-MiniLM-L6-v2, 0 API cost) or 'openai'
EMBEDDING_PROVIDER=local

# Optional OpenAI API Key for RAG Embeddings & LLM Synthesis
OPENAI_API_KEY=your_openai_api_key_here


